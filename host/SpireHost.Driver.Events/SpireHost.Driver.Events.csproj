<Project Sdk="Microsoft.NET.Sdk">

  <!-- Event drivers: EVENT (incl. Ancients / Neow / TheArchitect, IsProceed options), FakeMerchant, Crystal Sphere (CRYSTAL), Trial (CONFIRM), BUNDLE.
       A LIBRARY of the integrated host (H1 integration, rulings A2 / A3): it references the live SpireHost.Core /
       SpireHost.Driver projects, has no console entry of its own and is shipped inside the one executable
       (host\SpireHost). Its commands are reached as "SpireHost events <args>" (see host\README.md).
       Build:  dotnet build ..\SpireHost\SpireHost.csproj -c Release -nodeReuse:false -p:UseSharedCompilation=false
       Output: host\out\bin\SpireHost.Driver.Events\release\  (never a project-local bin\ or obj\).
       Contract: host\DRIVER-API.md. -->
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <AssemblyName>SpireHost.Driver.Events</AssemblyName>
    <RootNamespace>SpireHost.Driver.Events</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <SpireHostRef Include="Core" />
    <SpireHostRef Include="Driver" />
  </ItemGroup>

</Project>
