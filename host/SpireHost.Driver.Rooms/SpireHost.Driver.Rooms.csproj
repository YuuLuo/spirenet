<Project Sdk="Microsoft.NET.Sdk">

  <!-- Room drivers: REWARD / CARD_REWARD (RewardsSet.testSelector + proceed tree), TREASURE, REST, SHOP, out-of-combat potions.
       A LIBRARY of the integrated host (H1 integration, rulings A2 / A3): it references the live SpireHost.Core /
       SpireHost.Driver projects, has no console entry of its own and is shipped inside the one executable
       (host\SpireHost). Its commands are reached as "SpireHost rooms <args>" (see host\README.md).
       Build:  dotnet build ..\SpireHost\SpireHost.csproj -c Release -nodeReuse:false -p:UseSharedCompilation=false
       Output: host\out\bin\SpireHost.Driver.Rooms\release\  (never a project-local bin\ or obj\).
       Contract: host\DRIVER-API.md. -->
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <AssemblyName>SpireHost.Driver.Rooms</AssemblyName>
    <RootNamespace>SpireHost.Driver.Rooms</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <SpireHostRef Include="Core" />
    <SpireHostRef Include="Driver" />
  </ItemGroup>

</Project>
