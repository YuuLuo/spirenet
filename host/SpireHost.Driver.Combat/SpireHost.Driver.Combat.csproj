<Project Sdk="Microsoft.NET.Sdk">

  <!-- Combat driver: COMBAT decisions (play / potion / end turn / undo), the ready-for-input predicate, CARD_SELECT through the 15 CardSelectCmd.From* captures.
       A LIBRARY of the integrated host (H1 integration, rulings A2 / A3): it references the live SpireHost.Core /
       SpireHost.Driver projects, has no console entry of its own and is shipped inside the one executable
       (host\SpireHost). Its commands are reached as "SpireHost combat <args>" (see host\README.md).
       Build:  dotnet build ..\SpireHost\SpireHost.csproj -c Release -nodeReuse:false -p:UseSharedCompilation=false
       Output: host\out\bin\SpireHost.Driver.Combat\release\  (never a project-local bin\ or obj\).
       Contract: host\DRIVER-API.md. -->
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <AssemblyName>SpireHost.Driver.Combat</AssemblyName>
    <RootNamespace>SpireHost.Driver.Combat</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <SpireHostRef Include="Core" />
    <SpireHostRef Include="Driver" />
  </ItemGroup>

</Project>
